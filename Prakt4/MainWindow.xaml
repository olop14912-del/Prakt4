<Window x:Class="Prakt4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Триада" Height="420" Width="520">
    <StackPanel Margin="10">

        <TextBlock Text="Триада A:" FontWeight="Bold"/>
        <StackPanel Orientation="Horizontal" Margin="0,5">
            <TextBox x:Name="txtA1" Width="60" Margin="0,0,5,0"/>
            <TextBox x:Name="txtA2" Width="60" Margin="0,0,5,0"/>
            <TextBox x:Name="txtA3" Width="60"/>
        </StackPanel>

        <TextBlock Text="Триада B:" FontWeight="Bold"/>
        <StackPanel Orientation="Horizontal" Margin="0,5">
            <TextBox x:Name="txtB1" Width="60" Margin="0,0,5,0"/>
            <TextBox x:Name="txtB2" Width="60" Margin="0,0,5,0"/>
            <TextBox x:Name="txtB3" Width="60"/>
        </StackPanel>

        <TextBlock Text="Число:" FontWeight="Bold"/>
        <TextBox x:Name="txtNumber" Width="60" HorizontalAlignment="Left" Margin="0,5"/>

        <WrapPanel Margin="0,10">
            <Button Content="A + число" Width="100" Margin="0,0,5,5" Click="btnAddNumber_Click"/>
            <Button Content="A * число" Width="100" Margin="0,0,5,5" Click="btnMultiply_Click"/>
            <Button Content="A + B" Width="100" Margin="0,0,5,5" Click="btnAddTriad_Click"/>
            <Button Content="A = B ?" Width="100" Margin="0,0,5,5" Click="btnEqual_Click"/>
        </WrapPanel>

        <TextBlock Text="Результат:" FontWeight="Bold"/>
        <TextBox x:Name="txtResult" IsReadOnly="True" Height="30" Margin="0,5"/>

        <StackPanel Orientation="Horizontal" Margin="0,15">
            <Button Content="О программе" Width="120" Margin="0,0,10,0" Click="btnAbout_Click"/>
            <Button Content="Выход" Width="120" Click="btnExit_Click"/>
        </StackPanel>
    </StackPanel>
</Window>